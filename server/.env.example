# Server Port
PORT=5000

# Google Gemini API Key (get free at https://aistudio.google.com/)
# Leave blank to automatically run in Demo Mode with pre-written realistic responses!
GEMINI_API_KEY=

# Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Emergency Contact Numbers (Defaults for India, configurable)
EMERGENCY_NUMBER_DEFAULT=112
AMBULANCE_NUMBER_DEFAULT=108
SUICIDE_HELPLINE_DEFAULT=14416
